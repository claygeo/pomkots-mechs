# Preserve legacy tracked bytes instead of forcing a repository-wide EOL rewrite.
# Pin only the release-hardening inputs that were normalized in this branch.
.gitattributes text eol=lf
forge/build.gradle text eol=lf
forge/src/qualification/java/** text eol=lf
forge/src/qualification/resources/** text eol=lf
tools/**/*.py text eol=lf
tools/ashen_span_world/generation_datapack/** text eol=lf
docs/ashen-span-hardening/** text eol=lf
sector01-src/** text eol=lf
sector01-world/** text eol=lf

# Production resources are copied byte-for-byte unless a direct-copy resource
# below has an explicit canonical line ending.
LICENSE text eol=crlf
common/src/main/resources/** -text
forge/src/main/resources/** -text
fabric/src/main/resources/** -text
common/src/main/resources/data/pomkotsmechs/arena/solo_encounters.json text eol=lf
forge/src/main/resources/pack.mcmeta text eol=crlf

*.jar binary
*.zip binary
*.mrpack binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ogg binary
*.nbt binary
*.mca binary
*.dat binary
